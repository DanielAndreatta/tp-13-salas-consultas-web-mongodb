<article class="detalle">
    <h1>
        <%= titulo %>
    </h1>
    <p><strong>Estudiante:</strong>
        <%= reserva.estudiante %>
    </p>
    <p><strong>Email:</strong>
        <%= reserva.email %>
    </p>
    <p><strong>Sala:</strong>
        <%= reserva.sala %>
    </p>
    <p><strong>Fecha:</strong>
        <%= reserva.fecha %>
    </p>
    <p><strong>Turno:</strong>
        <%= reserva.turno %>
    </p>
    <p><strong>Cantidad de personas:</strong>
        <%= reserva.personas %>
    </p>
    <br>
    <div class="grupo-botones">
        <a class="boton" href="/reservas/<%= reserva.id %>/editar">Editar reserva</a>
        <a class="boton" href="/reservas/<%= reserva.id %>/estado">Cambiar estado</a>
        <a class="boton boton-rojo" href="/reservas/<%= reserva.id %>/eliminar">Eliminar reserva</a>
    </div>
    <a class="boton" href="/reservas">Volver al listado</a>
</article>